# Cortex XDR AI-Powered SOC Dashboard - Environment variables
# Copy this file to .env and fill in real values. Never commit real secrets.

# --- Application ---
ENVIRONMENT=development
DEBUG=true
APP_NAME=Cortex XDR AI SOC Dashboard
FRONTEND_ORIGIN=http://localhost:5173
BACKEND_CORS_ORIGINS=http://localhost:5173

# --- Security ---
SECRET_KEY=change-me-to-a-strong-random-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
BCRYPT_ROUNDS=12
DEFAULT_ADMIN_EMAIL=admin@example.local
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg2://soc:socpassword@db:5432/socdb

# --- Cortex XDR Integration ---
# Obtain API Key ID and API Key from Cortex XDR (Tenant Management > API Keys)
CORTEX_TENANT_FQDN=https://<your-tenant>.api.cortexdata.panw.io
CORTEX_API_KEY_ID=<your-api-key-id>
CORTEX_API_KEY=<your-api-key>
CORTEX_API_VERSION=v1
CORTEX_REQUEST_TIMEOUT_SECONDS=30
CORTEX_MAX_RETRIES=4
CORTEX_BASE_BACKOFF_SECONDS=1.0
CORTEX_SYNC_INTERVAL_SECONDS=300
CORTEX_SYNC_PAGE_SIZE=100
# Set true to run with unmistakably labeled synthetic demo data when no credentials
CORTEX_DEMO_MODE=false

# --- AI (provider-agnostic) ---
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_BASE_URL=
AI_API_KEY=
AI_PROMPT_VERSION=v1.0
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=1500
AI_ENABLED=true
AI_DEMO_MODE=false

# --- Rate limiting ---
RATE_LIMIT_REQUESTS_PER_MINUTE=60